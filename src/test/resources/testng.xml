<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="AutomationSuite" verbose="1" parallel="none">
    <listeners>
        <listener class-name="com.example.framework.reporting.ExtentTestListener"/>
    </listeners>
    <test name="WebTests">
        <packages>
            <package name="com.example.tests.web"/>
        </packages>
    </test>
    <test name="ApiTests">
        <packages>
            <package name="com.example.tests.api"/>
        </packages>
    </test>
</suite>
